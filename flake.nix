{
  description = "nitya - one self-hosted server for the day-to-day of life (PRJ-0001)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
    flake-parts.inputs.nixpkgs-lib.follows = "nixpkgs";
    # The yajna CLI for the notebook under notes/ (github:leoank/yajna).
    yajna.url = "github:leoank/yajna";
    yajna.inputs.nixpkgs.follows = "nixpkgs";
    # The owner's fleet config: its terranix stack runner (OpenTofu, encrypted state,
    # tf.env) and terranix modules, for nix/infra/ (github:leoank/neusis).
    neusis.url = "github:leoank/neusis";
    terranix.url = "github:terranix/terranix";
    terranix.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = inputs@{ flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [ "aarch64-darwin" "x86_64-darwin" "x86_64-linux" "aarch64-linux" ];

      imports = [
        # neusis's terranix bundle declares its input through flake-file, which only
        # neusis's own (generated) flake reads; nitya declares terranix above, so the
        # declaration is accepted here and ignored.
        ({ lib, ... }: {
          options.flake-file = lib.mkOption { type = lib.types.lazyAttrsOf lib.types.raw; default = { }; };
        })
        inputs.neusis.flakeModules.terranix
        ./nix/infra/nitya-oauth.nix
      ];

      # EXP-20261123-bhfz49's token probe as a NixOS service (neusis wires it on ghost001).
      flake.nixosModules.token-probe = ./nix/modules/token-probe.nix;

      perSystem = { config, pkgs, system, lib, ... }:
        let
          yajna = inputs.yajna.packages.${system}.yajna;

          # libtailscale as a static archive for the tailnet crate (ADR-0001), as saarthi and
          # sandhi build it: `ac7ed43` marks the descriptors it hands out close-on-exec
          # ([[saarthi/EXP-20261112-rq8kgc]]). Bump the Go attribute with the rev when its
          # go.mod moves.
          libtailscale = pkgs.buildGo127Module {
            pname = "libtailscale";
            version = "0-unstable-2026-10-30";
            src = pkgs.fetchFromGitHub {
              owner = "tailscale";
              repo = "libtailscale";
              rev = "ac7ed43af14e19e1c1810ee9f8319872c6beb412";
              hash = "sha256-K8QGeCyKBcYqBt9O192QpQ4EFRjgiPPE5djD+jyoM3M=";
            };
            vendorHash = "sha256-1Y21dNgCNMfVQvZN6k66GHvgdZo8lle5J8B5UES2Ryg=";
            env.CGO_ENABLED = "1";
            # A `package main` with cgo exports, built as a c-archive.
            buildPhase = ''
              runHook preBuild
              go build -buildvcs=false -buildmode=c-archive -o libtailscale.a .
              runHook postBuild
            '';
            installPhase = ''
              runHook preInstall
              install -Dm644 libtailscale.a $out/lib/libtailscale.a
              install -Dm644 tailscale.h $out/include/tailscale.h
              runHook postInstall
            '';
            doCheck = false;
          };

          # The cargo workspace; docs/ and notes/ stay out of it.
          src = lib.fileset.toSource {
            root = ./.;
            fileset = lib.fileset.unions [ ./Cargo.toml ./Cargo.lock ./crates ];
          };

          # One binary of the workspace; tests run in checks.workspace.
          bin = name: pkgs.rustPlatform.buildRustPackage {
            pname = name;
            version = "0.1.0";
            inherit src;
            cargoLock.lockFile = ./Cargo.lock;
            cargoBuildFlags = [ "--bin" name ];
            nativeBuildInputs = [ pkgs.protobuf ];
            # rusqlite builds SQLite in, but the link still names -lsqlite3 under nix.
            buildInputs = [ pkgs.sqlite ];
            PROTOC = "${pkgs.protobuf}/bin/protoc";
            LIBTAILSCALE_LIB_DIR = "${libtailscale}/lib";
            doCheck = false;
            meta.mainProgram = name;
          };
        in
        {
          packages = rec {
            inherit libtailscale;
            nitya-server = bin "nitya-server";
            nitya-node = bin "nitya-node";
            default = nitya-server;
            # One-time sign-in to Google or Microsoft for a refresh token (ADR-0009);
            # `nix run .#nitya-consent -- --help`.
            nitya-consent = pkgs.writers.writePython3Bin "nitya-consent" {
              flakeIgnore = [ "E501" ];
            } (builtins.readFile ./scripts/nitya-consent.py);
            # Do the provider tokens keep working on a headless server (EXP-20261123-bhfz49);
            # the service is nixosModules.token-probe.
            nitya-token-probe = pkgs.writers.writePython3Bin "nitya-token-probe" {
              flakeIgnore = [ "E501" ];
            } (builtins.readFile ./scripts/nitya-token-probe.py);
            # The user guide (mdBook, yajna's theme) published to GitHub Pages; the
            # reference and design sections are generated by docs/guide/build.py.
            docs = pkgs.runCommand "nitya-docs" {
              nativeBuildInputs = [ nitya-consent pkgs.mdbook pkgs.python3 ];
            } ''
              python3 ${./docs/guide/build.py} ${lib.fileset.toSource {
                root = ./.;
                fileset = lib.fileset.unions [ ./docs ./notes ];
              }} $out
            '';
          };

          devShells.default = pkgs.mkShell {
            packages = [
              pkgs.cargo
              pkgs.rustc
              pkgs.clippy
              pkgs.rustfmt
              pkgs.rust-analyzer
              pkgs.protobuf
              yajna
            ];
            PROTOC = "${pkgs.protobuf}/bin/protoc";
            LIBTAILSCALE_LIB_DIR = "${libtailscale}/lib";
            RUST_SRC_PATH = "${pkgs.rustPlatform.rustLibSrc}";
          };

          # The calendar round-trip spike (EXP-20261123-bhfzfs): the default shell plus
          # Radicale as a local CalDAV server, and Python for the Google and Graph drivers.
          devShells.calendar-spike = pkgs.mkShell {
            inputsFrom = [ config.devShells.default ];
            packages = [ pkgs.radicale pkgs.curl pkgs.python3 ];
          };

          # The cargo workspace, built and tested.
          checks.workspace = pkgs.rustPlatform.buildRustPackage {
            pname = "nitya";
            version = "0.1.0";
            inherit src;
            cargoLock.lockFile = ./Cargo.lock;
            nativeBuildInputs = [ pkgs.protobuf ];
            # rusqlite builds SQLite in, but the link still names -lsqlite3 under nix.
            buildInputs = [ pkgs.sqlite ];
            PROTOC = "${pkgs.protobuf}/bin/protoc";
            LIBTAILSCALE_LIB_DIR = "${libtailscale}/lib";
          };

          checks.docs = config.packages.docs;

          # nitya-consent against a fake provider on loopback, offline.
          checks.nitya-consent = pkgs.runCommand "nitya-consent-test" {
            nativeBuildInputs = [ pkgs.python3 ];
          } ''
            python3 ${./scripts/test-nitya-consent.py} ${config.packages.nitya-consent}/bin/nitya-consent
            touch $out
          '';

          # nitya-token-probe against a fake of every endpoint it calls, offline.
          checks.nitya-token-probe = pkgs.runCommand "nitya-token-probe-test" {
            nativeBuildInputs = [ pkgs.python3 ];
          } ''
            python3 ${./scripts/test-nitya-token-probe.py} ${config.packages.nitya-token-probe}/bin/nitya-token-probe
            touch $out
          '';

          # The module evaluates in a NixOS system and passes the secrets as credentials.
          checks.token-probe-module =
            let
              sys = inputs.nixpkgs.lib.nixosSystem {
                system = "x86_64-linux";
                modules = [
                  ./nix/modules/token-probe.nix
                  {
                    boot.isContainer = true;
                    system.stateVersion = "25.11";
                    services.nitya-token-probe = {
                      enable = true;
                      googleClientFile = "/run/agenix/g-client";
                      microsoftTokenFile = "/run/agenix/m-token";
                    };
                  }
                ];
              };
              sc = sys.config.systemd.services.nitya-token-probe.serviceConfig;
              exec = builtins.unsafeDiscardStringContext sc.ExecStart;
            in
            assert sc.LoadCredential == [ "google-client:/run/agenix/g-client" "microsoft-token:/run/agenix/m-token" ];
            assert lib.hasSuffix "--state /var/lib/nitya-token-probe --google-client %d/google-client --microsoft-token %d/microsoft-token" exec;
            assert sys.config.systemd.timers.nitya-token-probe.timerConfig.OnCalendar == "*-*-* 00/6:00:00";
            pkgs.runCommand "token-probe-module" { } "touch $out";

          # The notebook passes yajna validate.
          checks.notebook = pkgs.runCommand "nitya-notebook" {
            nativeBuildInputs = [ yajna ];
          } ''
            cd ${lib.fileset.toSource {
              root = ./.;
              # Run pages name their scripts under spikes/; validate checks they exist.
              fileset = lib.fileset.unions [ ./yajna.toml ./notes ./docs ./spikes ];
            }}
            yajna --root . validate
            touch $out
          '';
        };
    };
}
